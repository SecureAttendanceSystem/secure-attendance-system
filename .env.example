# Optional: override the local database with a Supabase PostgreSQL connection.
# Plain PostgreSQL URLs also work; the backend selects Psycopg 3 automatically.
# Require SSL for Supabase using ?sslmode=require.
# URL-encode special characters in the password.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
BACKEND_PORT=18000
APP_NAME="Secure Attendance API"
ENVIRONMENT=development
LOG_LEVEL=INFO
# JSON array of exact browser origins, without a trailing slash.
CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'
# Required: Supabase project URL and service role key (Project Settings > API).
# The backend verifies user tokens against this project's JWKS endpoint and
# uses the service role key to provision accounts via the Admin API — never
# expose the service role key to the frontend.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=change-me-to-your-service-role-key
