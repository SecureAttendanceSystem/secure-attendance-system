# Optional: override the local database with a Supabase PostgreSQL connection.
# Plain PostgreSQL URLs also work; the backend selects Psycopg 3 automatically.
# Require SSL for Supabase using ?sslmode=require.
# URL-encode special characters in the password.
# DATABASE_URL=postgresql+psycopg://USER:PASSWORD@HOST:5432/postgres?sslmode=require
BACKEND_PORT=18000
APP_NAME="Secure Attendance API"
ENVIRONMENT=development
LOG_LEVEL=INFO
# JSON array of exact browser origins, without a trailing slash.
CORS_ORIGINS='["http://localhost:3000","http://127.0.0.1:3000"]'
