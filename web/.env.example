# Browser-facing API address; match BACKEND_PORT in the repository root .env.
NEXT_PUBLIC_API_URL=http://localhost:18000

# Use the same Supabase project as the backend. Fill these in web/.env.local.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# NEXT_PUBLIC_ values are included in browser code.
# Never put a Supabase service-role key, secret key, or database password here.
